{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Gender Distribution by Region",
    "data": {
        "url": "https://raw.githubusercontent.com/VerakarnM/FIT2179_DV2/refs/heads/main/Interstate_Migration_2017_2025.csv"
    },
    "width":300,
    "params": [
        {
            "name": "selectedYear",
            "value": 2017,
            "bind": {
                "input": "select",
                "options": [
                    2017,
                    2018,
                    2019,
                    2020,
                    2021,
                    2022,
                    2023,
                    2024,
                    2025
                ],
                "name": "Year: "
            }
        }
    ],
    "transform": [
        {
            "filter": "datum.Measure === 'NIM Arrivals' && datum.Age === 'All ages' && datum.Region != 'Australia' && datum.Sex != 'Persons'"
        },
        {
            "filter": "toNumber(datum.TIME_PERIOD) == selectedYear"
        }
    ],
    "mark": "bar",
    "encoding": {
        "x": {
            "field": "Region",
            "title": "State or Territory"
        },
        "y": {
            "field": "OBS_VALUE",
            "type": "quantitative",
            "title": "Arrivals/Departures"
        },
        "xOffset": {
            "field": "Sex"
        },
        "color": {
            "field": "Sex",
            "scale":{
                "range":["red","teal"]
            }
        },
        "tooltip":{
                "field": "OBS_VALUE",
                "type": "quantitative",
                "format": ","
            
        }
    }
}